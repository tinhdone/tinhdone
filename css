/* Stylesheet cho Website Miền Trung Yêu Thương */
:root {
  --primary-color: #0d6efd;
  --primary-dark: #0a58ca;
  --text-color: #212529;
  --bg-light: #f8f9fa;
  --border-color: #dee2e6;
  --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-family);
  color: var(--text-color);
  line-height: 1.6;
  background-color: #fff;
}

.container {
  max-width: 1140px;
  margin: 0 auto;
  padding: 0 20px;
}

/* Header & Nav */
.site-header {
  background: #fff;
  border-bottom: 1px solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 1000;
}

.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 20px;
}

.brand {
  font-size: 1.25rem;
  font-weight: bold;
  text-decoration: none;
  color: var(--text-color);
}

.brand-mark {
  color: var(--primary-color);
}

.nav-links {
  display: flex;
  list-style: none;
  gap: 15px;
}

.nav-links a {
  text-decoration: none;
  color: var(--text-color);
  padding: 5px 10px;
  border-radius: 4px;
}

.nav-links a[aria-current="page"],
.nav-links a:hover {
  color: var(--primary-color);
  font-weight: 600;
}

/* Sections */
.section {
  padding: 60px 0;
}

.section-alt {
  background-color: var(--bg-light);
}

.section-head {
  text-align: center;
  margin-bottom: 40px;
}

.section-head h1, .section-head h2 {
  font-size: 2rem;
  margin-bottom: 10px;
}

.lede {
  font-size: 1.1rem;
  color: #6c757d;
}

/* Hero */
.hero {
  padding: 60px 0;
  background-color: var(--bg-light);
}

.hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
}

.hero-art img, .feature-art img, .card img, .gallery img {
  width: 100%;
  height: auto;
  border-radius: 8px;
  object-fit: cover;
}

.eyebrow {
  text-transform: uppercase;
  font-size: 0.85rem;
  letter-spacing: 1px;
  color: var(--primary-color);
  font-weight: bold;
}

.hero h1 {
  font-size: 2.5rem;
  margin: 15px 0;
  line-height: 1.2;
}

/* Cards & Grid */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 20px;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
}

.card {
  border: 1px solid var(--border-color);
  border-radius: 8px;
  overflow: hidden;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.card img {
  height: 200px;
  border-radius: 0;
}

.card-body {
  padding: 20px;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
}

.card-body h3 {
  margin-bottom: 10px;
}

.card-body p {
  color: #6c757d;
  font-size: 0.95rem;
  margin-bottom: 15px;
  flex-grow: 1;
}

/* Buttons */
.btn {
  display: inline-block;
  padding: 10px 20px;
  border-radius: 6px;
  text-decoration: none;
  font-weight: 600;
  text-align: center;
  cursor: pointer;
}

.btn-primary {
  background-color: var(--primary-color);
  color: #fff;
  border: none;
}

.btn-primary:hover {
  background-color: var(--primary-dark);
}

.btn-outline {
  border: 1px solid var(--primary-color);
  color: var(--primary-color);
  background: transparent;
}

.btn-light {
  background: #fff;
  color: var(--primary-color);
}

/* Feature panel */
.feature-panel {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
}

.feature-panel.reverse .feature-art {
  order: 2;
}

.place-name {
  color: var(--primary-color);
  font-weight: bold;
}

/* Jump links */
.jump-links {
  display: flex;
  justify-content: center;
  gap: 20px;
  list-style: none;
  margin-top: 20px;
}

.jump-links a {
  padding: 8px 16px;
  background: var(--bg-light);
  border-radius: 20px;
  text-decoration: none;
  color: var(--text-color);
  border: 1px solid var(--border-color);
}

/* Stats */
.stats {
  display: flex;
  justify-content: space-around;
  text-align: center;

}

.stat strong {
  display: block;
  font-size: 2.5rem;
  color: var(--primary-color);
}

/* CTA band */
.cta-band {
  background: var(--primary-color);
  color: #fff;
  padding: 40px 0;
}

.cta-band .container {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* Timeline */
.timeline-item {
  position: relative;
  padding-left: 30px;
  margin-bottom: 30px;
  border-left: 2px solid var(--primary-color);
}

.when {
  font-size: 0.85rem;
  color: var(--primary-color);
  font-weight: bold;
}

/* Gallery */
.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
}

.gallery figure {
  margin: 0;
}

.gallery figcaption {
  text-align: center;
  margin-top: 8px;
  font-size: 0.9rem;
  color: #6c757d;
}

/* Contact Grid & Form */
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.form label {
  font-weight: 600;
}

.form input, .form select, .form textarea {
  padding: 10px;
  border: 1px solid var(--border-color);
  border-radius: 4px;
  font-family: inherit;
}

.form textarea {
  min-height: 120px;
}

/* Footer */
.site-footer {
  background: #212529;
  color: #f8f9fa;
  padding: 40px 0 20px 0;
}

.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 2fr;
  gap: 40px;
  margin-bottom: 30px;
}

.footer-grid h3 {
  margin-bottom: 15px;
  color: #fff;
}

.footer-grid ul {
  list-style: none;
}

.footer-grid a {
  color: #adb5bd;
  text-decoration: none;
}

.footer-grid a:hover {
  color: #fff;
}

.footer-bottom {
  text-align: center;
  padding-top: 20px;
  border-top: 1px solid #343a40;
  color: #6c757d;
  font-size: 0.85rem;
}

/* Responsive */
@media (max-width: 768px) {
  .hero-grid, .feature-panel, .contact-grid, .footer-grid {
    grid-template-columns: 1fr;
  }
  .feature-panel.reverse .feature-art {
    order: 0;
  }
  .cta-band .container {
    flex-direction: column;
    gap: 20px;
    text-align: center;
  }
  .nav {
    flex-direction: column;
    gap: 15px;
  }
  .nav-links {
    flex-wrap: wrap;
    justify-content: center;
  }
}
